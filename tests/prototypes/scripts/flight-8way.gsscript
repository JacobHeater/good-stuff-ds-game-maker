# 3D 8-way flight and walking with an orbiting camera.
# Attach this script to a node that has a CollisionShape3D under it (a body), for example your player or butterfly.
# The camera is a Camera3D child of that node, named "Camera3D". The script places and turns it every frame, so it can stay at the origin in the editor.
# The model's front is taken to be -Z (how Godot models face). If yours faces +Z, set model_front_yaw to 0.
# (If the node has no collision shape, use flight-8way-free.gsscript instead.)
#
# Controls:
#   D-pad         : walk on the ground, fly in the air, in 8 directions relative to where the camera looks
#   X (hold)      : fly up (this also takes off from the ground) -- needs at least min_energy_to_fly energy
#   B (hold)      : fly down (touching the ground lands and goes back to walking)
#   L / R         : orbit the camera around the player

# --- Tuning ---
var flight_speed = 7.0        # flying speed sideways (units a second)
var walk_speed = 4.0          # walking speed on the ground (0 turns walking off)
var ground_drag = 10.0        # how fast it stops walking when the D-pad is let go
var climb_speed = 4.0         # how fast X lifts it
var descend_speed = 4.0       # how fast B lowers it
var takeoff_lift = 2.0        # the little hop when X first lifts it off the ground
var fall_gravity = -1.5       # gravity when walking or falling
var acceleration = 10.0       # how fast it reaches the wanted speed
var air_drag = 3.0            # how fast it slows when let go in the air
var model_front_yaw = 180.0   # the turn that points the model's front along its travel: 180 for a model that faces -Z, 0 for one that faces +Z
var camera_turn_speed = 90.0  # degrees a second the camera orbits
var camera_dist = 6.5         # how far behind the player the camera is
var camera_height = 1.0       # how far above the player
var shadow_max_fall = 50.0    # how far down $Shadow looks for ground; no ground within this and it hides
var shadow_lift = 0.05        # how far above the ground $Shadow sits, so it doesn't flicker into the floor
var shadow_full_size_height = 1.0  # at this height or less above the ground, $Shadow is full size
var shadow_min_scale = 0.4    # the smallest $Shadow shrinks to, high in the air
var shadow_fade_height = 6.0  # the height above the ground at which $Shadow is at its smallest
var min_energy_to_fly = 25    # below this, X can't take off, and flying already in the air is cut short (forced into a fall)
var energy_drain_ticks = 8    # how many _process frames a flying tick lasts before energy_drain_amount is taken
var energy_drain_amount = 5   # how much energy flying costs every energy_drain_ticks frames

# --- State ---
var is_flying = false
var vx = 0.0
var vy = 0.0
var vz = 0.0
var cam_angle = 0.0           # which way the camera looks, in degrees (0 looks toward +Z)
var anim_state = -1           # which animation is playing: 0 the "Ground" one, 1 the "Fly" one (-1: none yet)
var energy_timer = 8.0

# The player's energy: flying costs it over time (see energy_drain_*), and X can't take off -- nor keep flying --
# below min_energy_to_fly. A global var, not a plain one, so a HUD label or anything else that cares about it (in
# any scene) can read or show it without needing to know this player's own node name or structure.
global var energy = 100

# The camera's true heading in the world, shared with any other script in any scene that needs to face the camera
# (a billboard name tag, a billboarded tree) without needing to know this player's own node names or structure.
# A plain global var always exists (0.0 until this script has run), so it works even in a scene that never has
# this player in it at all -- unlike a node reference, which needs the actual node to be there.
global var camera_world_yaw = 0.0

# The player's own position and heading in the world, shared the same way -- for anything that needs to track the REAL
# player, such as a minimap. This matters because the D-pad's own direction is relative to the camera (see step 3 in
# _process), not a fixed compass direction: a minimap that just watched the D-pad itself (as if up always meant north)
# would drift out of step with the player the moment the camera is orbited with L/R, since the same D-pad press then
# sends the player a different way in the world. Reading the player's actual position here instead can't disagree with it.
global var player_world_x = 0.0
global var player_world_z = 0.0
global var player_world_yaw = 0.0

func _ready():
    cam_angle = rotation.y
    update_camera()
    update_animation()
    update_shadow()
    update_world_position()

# Plays "Ground" while on the ground and "Fly" in the air. play() starts an animation over from its first frame, so it is only called when the choice CHANGES:
# calling it every frame would hold the animation on its first frame.
func update_animation():
    var want = 0
    if is_flying:
        want = 1
    if want != anim_state:
        anim_state = want
        if want == 1:
            $AnimationPlayer.play("Fly")
        else:
            $AnimationPlayer.play("Ground")

# Keeps an angle between -180 and 180.
func wrap_angle(deg: float) -> float:
    if deg > 180.0:
        return deg - 360.0
    if deg < -180.0:
        return deg + 360.0
    return deg

# Puts the camera behind the player on its orbit, looking at the player.
# sin() and cos() take degrees. The camera is a child, so it follows the player's own turn: its place and heading are worked out
# in the player's space (the world offset turned back by the player's heading).
func update_camera():
    var a = cam_angle
    var yaw = rotation.y
    var back_x = -sin(a) * camera_dist
    var back_z = -cos(a) * camera_dist
    $Camera3D.position.x = back_x * cos(yaw) - back_z * sin(yaw)
    $Camera3D.position.y = camera_height
    $Camera3D.position.z = back_x * sin(yaw) + back_z * cos(yaw)
    # A camera looks along its own -Z, so it needs to be turned half way round to look toward +Z.
    var cam_local_yaw = wrap_angle(a + 180.0 - yaw)
    $Camera3D.rotation.y = cam_local_yaw
    # $Camera3D's rotation is relative to this node (its parent), so its true world heading is the two added together.
    camera_world_yaw = wrap_angle(cam_local_yaw + yaw)

# A flat shadow under the player: sits right on the ground (found with a ray straight down, so it works over uneven ground and while flying,
# not just a fixed floor height), shrinks the higher up it is (a common depth cue: with no real-time shadows on the DS, size is what says how
# far above the ground the player is), doesn't turn with the player (a round blob shadow doesn't need to), and hides over a drop with no floor
# under it at all, instead of floating in the air.
func update_shadow():
    # position is taken as this node's world position: true as long as it is a top-level node (not nested under another that moves or turns it),
    # which is how this script expects to be used.
    var fall = ray_cast(position.x, position.y, position.z, 0.0, -1.0, 0.0, shadow_max_fall)
    if fall < 0.0:
        $Shadow.visible = false
        return
    $Shadow.visible = true
    # Directly below the player: (0, 0) in this node's own space is still (0, 0) however this node is turned, since turning doesn't move a
    # point that sits on the turning axis.
    $Shadow.position.x = 0.0
    $Shadow.position.z = 0.0
    # This node's own height plus the shadow's local offset must land it on the ground the ray found, a little above it so it doesn't flicker.
    $Shadow.position.y = -fall + shadow_lift
    # Staying flat on the ground regardless of the player's own turn (undoing this node's own yaw): a round shadow doesn't need this, but an
    # oval or a directional one would otherwise spin with the player.
    $Shadow.rotation.x = 0.0
    $Shadow.rotation.y = wrap_angle(-rotation.y)
    $Shadow.rotation.z = 0.0
    # Smaller the higher up the player is, between full size at shadow_full_size_height or less and shadow_min_scale at shadow_fade_height or more.
    var height_above_ground = fall
    var shadow_scale = 1.0
    if height_above_ground > shadow_full_size_height:
        var t = (height_above_ground - shadow_full_size_height) / (shadow_fade_height - shadow_full_size_height)
        if t > 1.0:
            t = 1.0
        shadow_scale = 1.0 - t * (1.0 - shadow_min_scale)
    $Shadow.scale.x = shadow_scale
    $Shadow.scale.y = shadow_scale
    $Shadow.scale.z = shadow_scale

# Publishes this node's own position and heading (see player_world_x/z/yaw above). position is taken as this node's world
# position: true as long as it is a top-level node (not nested under another that moves or turns it), which is how this
# script expects to be used.
func update_world_position():
    player_world_x = position.x
    player_world_z = position.z
    player_world_yaw = rotation.y

func _process(delta):
    var up = Input.is_button_down("x")
    var down = Input.is_button_down("b")

    # 1. Taking off and landing: X lifts it off the ground, but only with enough energy; touching the ground
    # (without X held) lands it. Energy running out mid-flight cuts flying short too, not just a fresh takeoff:
    # otherwise flying above the threshold once would let it fly forever, ignoring energy from then on.
    if up and not is_flying and energy >= min_energy_to_fly:
        is_flying = true
        vy = takeoff_lift
    if is_flying and energy < min_energy_to_fly:
        is_flying = false
    if is_flying and is_on_floor() and not up and vy <= 0.0:
        is_flying = false

    # 2. L and R orbit the camera.
    if Input.is_button_down("l"):
        cam_angle -= camera_turn_speed * delta
    if Input.is_button_down("r"):
        cam_angle += camera_turn_speed * delta
    cam_angle = wrap_angle(cam_angle)

    # 3. The D-pad as a direction: up is forward, right is to the right of the camera's view.
    var input_x = 0.0
    var input_z = 0.0
    if Input.is_button_down("up"):
        input_z += 1.0
    if Input.is_button_down("down"):
        input_z -= 1.0
    if Input.is_button_down("left"):
        input_x -= 1.0
    if Input.is_button_down("right"):
        input_x += 1.0

    # A diagonal is not faster (1 / sqrt(2) is about 0.7071).
    var input_len_sq = input_x * input_x + input_z * input_z
    if input_len_sq > 1.0:
        input_x *= 0.7071
        input_z *= 0.7071

    # 4. That direction in the world. A camera that looks toward (sin a, cos a) has its right-hand side toward (-cos a, sin a).
    var sin_a = sin(cam_angle)
    var cos_a = cos(cam_angle)
    var target_vx = (-input_x * cos_a + input_z * sin_a) * flight_speed
    var target_vz = (input_x * sin_a + input_z * cos_a) * flight_speed

    if is_flying:
        # Flying: sideways with the D-pad, up with X, down with B, and it hangs in the air when neither is held.
        var target_vy = 0.0
        if up:
            target_vy = climb_speed
        if down:
            target_vy = -descend_speed
        vy += (target_vy - vy) * acceleration * delta
        if input_len_sq > 0.01:
            vx += (target_vx - vx) * acceleration * delta
            vz += (target_vz - vz) * acceleration * delta
            # Face the way it is flying (atan2 gives degrees).
            rotation.y = wrap_angle(atan2(vx, vz) + model_front_yaw)
        else:
            vx -= vx * air_drag * delta
            vz -= vz * air_drag * delta
    else:
        vy += fall_gravity * delta
        if is_on_floor() and walk_speed > 0.0:
            # Walking on the ground: the same D-pad, at walking speed, still relative to the camera.
            if input_len_sq > 0.01:
                var walk = walk_speed / flight_speed
                vx += (target_vx * walk - vx) * acceleration * delta
                vz += (target_vz * walk - vz) * acceleration * delta
                rotation.y = wrap_angle(atan2(vx, vz) + model_front_yaw)
            else:
                vx -= vx * ground_drag * delta
                vz -= vz * ground_drag * delta
        else:
            vx -= vx * air_drag * delta
            vz -= vz * air_drag * delta

    # Flying costs energy over time, not per frame directly: energy_timer counts down energy_drain_ticks frames
    # of flying, then energy_drain_amount is taken and the timer starts over.
    if is_flying:
        energy_timer -= 1.0
        if energy_timer <= 0.0:
            energy_timer = energy_drain_ticks
            energy -= energy_drain_amount
            if energy < 0:
                energy = 0

    update_animation()

    # 5. Move, then put the camera and the shadow where they belong, and publish the new position.
    move_and_collide(vx * delta, vy * delta, vz * delta)
    update_camera()
    update_shadow()
    update_world_position()
