  "scripts": [
    {
      "id": "world",
      "name": "World",
      "source": "# Keeps the day/night cycle and the persisted best day; everyone else just reads these globals.\nglobal var day = 1\nglobal var bestDay = 0\nglobal var lives = 3\n\nvar dayTimer = 0.0\nvar isDay = true\n\nfunc _ready():\n    if has_save():\n        load_game()\n    $Day.value = day\n    $Best.value = bestDay\n    $Lives.value = lives\n    $DayNight.text = \"DAY\"\n\nfunc _process(delta):\n    dayTimer += delta\n    if isDay and dayTimer >= 10.0:\n        isDay = false\n        dayTimer = 0.0\n        $SkyDay.visible = false\n        $SkyNight.visible = true\n        $DayNight.text = \"NIGHT\"\n    elif not isDay and dayTimer >= 10.0:\n        isDay = true\n        dayTimer = 0.0\n        day += 1\n        $Day.value = day\n        $SkyDay.visible = true\n        $SkyNight.visible = false\n        $DayNight.text = \"DAY\"\n"
    },
    {
      "id": "player",
      "name": "Player",
      "source": "# Runs, jumps, falls back from the edge, and places/removes campfires from the Wood in the Bag.\nglobal var day = 1\nglobal var bestDay = 0\nglobal var lives = 3\nglobal var lastFire = -1\n\nvar vy = 0.0\nvar over = false\n\nfunc _ready():\n    pass\n\nfunc _process(delta):\n    if over:\n        if Input.is_button_pressed(\"start\"):\n            change_scene(\"Island\")\n        return\n\n    var speed = 5.0\n    var dx = 0.0\n    var dz = 0.0\n    if Input.is_button_down(\"left\"):\n        dx = -speed * delta\n    if Input.is_button_down(\"right\"):\n        dx = speed * delta\n    if Input.is_button_down(\"up\"):\n        dz = -speed * delta\n    if Input.is_button_down(\"down\"):\n        dz = speed * delta\n    if is_on_floor():\n        vy = 0.0\n        if Input.is_button_pressed(\"a\"):\n            vy = 8.0\n    vy -= 20.0 * delta\n    move_and_collide(dx, vy * delta, dz)\n\n    if position.y < -3.0:\n        position.x = 0.0\n        position.y = 1.0\n        position.z = 0.0\n        vy = 0.0\n        lives -= 1\n        $Lives.value = lives\n        if lives <= 0:\n            over = true\n            if bestDay == 0 or day > bestDay:\n                bestDay = day\n            save_game()\n            $Message.visible = true\n\n    if Input.is_button_pressed(\"b\"):\n        if $Bag.count(\"Wood\") >= 2:\n            var h = spawn(\"Campfires\", position.x, position.y, position.z)\n            if is_spawned(h):\n                $Bag.remove(\"Wood\", 2)\n                lastFire = h\n    if Input.is_button_pressed(\"x\"):\n        if is_spawned(lastFire):\n            despawn(lastFire)\n            lastFire = -1\n"
    },
    {
      "id": "tree",
      "name": "Tree",
      "source": "# A tree: chopped for 2 Wood when the player bumps into it.\nfunc _process(delta):\n    if visible and $TreeShape.overlaps($PlayerShape):\n        visible = false\n        $Bag.add(\"Wood\", 2)\n"
    },
    {
      "id": "coconut",
      "name": "Coconut",
      "source": "# A coconut: picked up for 1 Coconut when the player walks over it.\nfunc _process(delta):\n    if visible and $CoconutShape.overlaps($PlayerShape):\n        visible = false\n        $Bag.add(\"Coconut\", 1)\n"
    },
    {
      "id": "crab",
      "name": "Crab",
      "source": "# Wanders the island, turning away whenever the ground ahead runs out, and snatches a Wood if it catches the player.\nvar angle = 0.0\nvar retarget = 0.0\n\nfunc _ready():\n    angle = float(randi(360))\n\nfunc _process(delta):\n    retarget -= delta\n    var ahead = ray_cast(position.x, position.y + 0.5, position.z, sin(angle), -1.0, cos(angle), 2.0)\n    if ahead < 0.0 or retarget <= 0.0:\n        angle = float(randi(360))\n        retarget = 2.0\n    move_and_collide(sin(angle) * delta, -10.0 * delta, cos(angle) * delta)\n    rotation.y = -angle\n    if $CrabShape.overlaps($PlayerShape) and $Bag.count(\"Wood\") > 0:\n        $Bag.remove(\"Wood\", 1)\n"
    },
    {
      "id": "camera",
      "name": "CameraFollow",
      "source": "# Follows the player from a fixed distance, same as the coin game's.\nfunc _process(delta):\n    position.x = $Player.position.x\n    position.z = $Player.position.z + 9.0\n"
    }
  ]
}