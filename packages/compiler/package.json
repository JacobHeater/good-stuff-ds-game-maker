{
  "name": "@goodstuff/compiler",
  "version": "0.0.1",
  "private": true,
  "description": "Compiles a saved project into a Nintendo DS ROM: translation to DS-ready scene data, diagnostics, and the toolchain build driver.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(no lint configured yet for @goodstuff/compiler)\"",
    "cli:build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.mjs --log-level=warning"
  },
  "dependencies": {
    "@goodstuff/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.169.0",
    "esbuild": "0.21.5",
    "pngjs": "^7.0.0",
    "three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
